#!/usr/bin/env bash
# msbos — define o papel de parede com swaybg.
#
# Ordem de busca (1ª imagem encontrada):
#   1) ~/.config/msbos-walls/
#   2) /usr/share/msbos-walls/
# Sem imagens → cor sólida mSurface da paleta macOS (#0B0B0D). O dono do
# wallpaper é o Noctalia ([wallpaper.default] no settings.toml); este helper
# é só fallback (ex.: sessão sem Noctalia).

set -u

DIRS=("${HOME}/.config/msbos-walls" "/usr/share/msbos-walls")

for d in "${DIRS[@]}"; do
  [[ -d ${d} ]] || continue
  img="$(find "${d}" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    2>/dev/null | sort | head -n1)"
  if [[ -n ${img} ]]; then
    exec swaybg -i "${img}"
  fi
done

exec swaybg --color "#0B0B0D"
