#!/usr/bin/env bash
# MyOS — fixa o governor de CPU em "performance" (desktop sem bateria).
# Silencioso e idempotente: seguro para rodar a cada boot.

set -u

changed=0
for gov in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
  [[ -w ${gov} ]] || continue
  cur="$(cat "${gov}" 2>/dev/null || true)"
  if [[ ${cur} != performance ]]; then
    if echo performance > "${gov}" 2>/dev/null; then
      changed=$((changed + 1))
    fi
  fi
done

if (( changed > 0 )); then
  echo "myos-cpu-governor: ${changed} CPUs ajustadas para performance"
fi
exit 0
