#!/usr/bin/env bash
# omyfedora — sincroniza a aparência com o Noctalia Greeter no primeiro login.
#
# O 50-configs.sh dispara o Sync Now quando já existe uma sessão com o Noctalia
# (reinstalação). Numa instalação limpa o shell só sobe no primeiro login, então
# este helper, instalado no autostart do usuário, espera o IPC do Noctalia e faz
# o sync uma única vez. O marcador evita repetir a operação a cada login;
# apague-o para forçar um novo sync no próximo login (ou rode
# `noctalia msg greeter-sync` na sessão).

set -euo pipefail

marker="${XDG_STATE_HOME:-${HOME}/.local/state}/omyfedora/greeter-sync.done"
[[ -f ${marker} ]] && exit 0

# Só faz sentido na sessão niri (o Noctalia é o shell dela); em outra sessão
# (ex.: Plasma mantido com --skip-remove) o autostart não deve esperar o IPC.
[[ ${XDG_CURRENT_DESKTOP:-} == *niri* ]] || exit 0

# Sem o shell ou o greeter instalados não há o que sincronizar (ex.: --no-greeter).
command -v noctalia >/dev/null 2>&1 || exit 0
command -v noctalia-greeter >/dev/null 2>&1 || exit 0

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# O niri inicia o Noctalia em paralelo com o autostart; espera o socket IPC.
for _ in {1..30}; do
  if compgen -G "${runtime}/noctalia-*.sock" >/dev/null; then
    break
  fi
  sleep 1
done

# Se o socket apareceu mas o shell ainda não responde, tenta mais algumas vezes.
for _ in {1..5}; do
  if noctalia msg greeter-sync >/dev/null 2>&1; then
    mkdir -p "$(dirname "${marker}")"
    : > "${marker}"
    exit 0
  fi
  sleep 2
done

# Sem marcador: o próximo login tenta de novo (útil se o Noctalia demorou a subir).
exit 0
