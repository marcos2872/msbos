# MyOS — padrão escuro do KDE/Breeze para GTK/libadwaita/portal (via `dconf update`).
# Os apps GTK/Electron (e o portal org.freedesktop.appearance) leem o dconf; sem
# isto cairiam no Adwaita claro/escuro padrão do GTK, divergindo dos apps KDE
# (que usam o Breeze Dark do kdeglobals — ver 50-configs.sh).
# NOTA: o caminho org/gnome/desktop/interface é só o transporte do padrão
# freedesktop (lido por GTK/libadwaita/portais) — o desktop GNOME não está
# instalado; o Fedora usa o KDE e o MyOS troca o shell pelo niri.
# Valores = os defaults do Fedora KDE: tema GTK Breeze (variante escura via
# prefer-dark), ícones breeze-dark e cursor breeze_cursors.
[org/gnome/desktop/interface]
gtk-theme='Breeze'
color-scheme='prefer-dark'
icon-theme='breeze-dark'
cursor-theme='breeze_cursors'
cursor-size=24
font-name='Noto Sans 10'
