#!/usr/bin/env bash
# omyfedora — remove o shell do Plasma no boot (antes da sessão gráfica).
#
# Executado UMA vez pelo omyfedora-remove-plasma.service, antes do greetd/graphical.
#
# Por que no boot? Remover o desktop em uso derruba a sessão gráfica atual: o
# %preun do plasmalogin/plasma-* mexe nos serviços systemd (remove-system-units
# para/desabilita o plasmalogin) — matando o instalador no meio da transação
# dnf. O mesmo valia para o gdm (base Workstation antiga).
#
# Comportamento:
#   - desativa temporariamente a proteção de pacotes do Fedora KDE
#     (plasma-desktop é protegido em /etc/dnf/protected.d/) e re-protege
#     NetworkManager/tuned/tuned-ppd + os pacotes que o omyfedora mantém para os
#     apps KDE (plasma-integration, plasma-breeze, plasma-systemsettings,
#     polkit-kde, xdg-desktop-portal-kde) via --setopt append (o dnf5 soma,
#     não substitui)
#   - marca os mantidos como escolha do usuário (dnf mark user): sem eles os
#     apps Qt perdem o estilo Breeze, o portal KDE e os diálogos de senha
#   - remove o que ainda estiver instalado numa única transação
#   - sucesso: desabilita e remove a si mesmo
#   - falha: permanece habilitado para tentar de novo no próximo boot

set -u

LOG_TAG="omyfedora-remove-plasma"

log() { echo "[${LOG_TAG}] $*"; }

# Proteção do dnf (plasma-desktop): mover para fora e restaurar no fim.
# Mesmo padrão do antigo script de remoção do GNOME (fedora-workstation.conf).
PROT_FILES=()
restore_prot() {
  local f
  for f in "${PROT_FILES[@]}"; do
    [[ -e ${f}.omyfedora-off ]] && mv -f "${f}.omyfedora-off" "${f}"
  done
  return 0
}
trap restore_prot EXIT

# limpa sobra de execução anterior interrompida (antes de mover de novo)
for f in /etc/dnf/protected.d/plasma-desktop.conf /etc/dnf/protected.d/fedora-workstation.conf; do
  [[ -e ${f}.omyfedora-off ]] && mv -f "${f}.omyfedora-off" "${f}"
done

for f in /etc/dnf/protected.d/plasma-desktop.conf /etc/dnf/protected.d/fedora-workstation.conf; do
  [[ -e ${f} ]] || continue
  mv -f "${f}" "${f}.omyfedora-off"
  PROT_FILES+=("${f}")
done

PKGS=()
for p in plasma-desktop plasma-workspace plasma-login-manager plasma-setup plasma-welcome; do
  if rpm -q "$p" >/dev/null 2>&1; then
    PKGS+=("$p")
  fi
done

# Pacotes que a transação NUNCA pode levar na cascata (clean_requirements_on_remove):
# NetworkManager/tuned/tuned-ppd são essenciais ao sistema; o Konsole é o
# terminal do dia a dia (não pode ser removido, pedido explícito); o resto é o
# que mantém os apps KDE funcionando (estilo Breeze, portal, agente polkit,
# KIO, miniaturas) e o menu XDG (redhat-menus: sem applications.menu o KSycoca
# fica sem apps e o Dolphin abre "Abrir com" vazio).
KEEP_PKGS=(NetworkManager tuned tuned-ppd konsole
  plasma-integration plasma-breeze plasma-systemsettings polkit-kde
  xdg-desktop-portal-kde pam-kwallet kde-gtk-config kde-cli-tools dconf
  breeze-icon-theme breeze-cursor-theme redhat-menus
  kio-extras kio-admin kdegraphics-thumbnailers ffmpegthumbs
  kglobalacceld kf6-kwallet)
# Apps que o 20-stack marca como user-installed; o preflight também os vigia.
APP_PKGS=(dolphin kwrite okular gwenview ark kcalc spectacle kde-connect
  kfind dragon elisa-player plasma-systemmonitor kinfocenter)
# protected_packages do dnf: lista derivada de KEEP_PKGS (uma fonte só).
PROT_PKGS="$(IFS=,; printf '%s' "${KEEP_PKGS[*]}")"

for p in "${KEEP_PKGS[@]}" "${APP_PKGS[@]}"; do
  if rpm -q "$p" >/dev/null 2>&1; then
    dnf -y mark user "$p" >/dev/null 2>&1 \
      || log "aviso: falha ao marcar ${p} como user-installed"
  fi
done

# malcontent: exigido pelo Flatpak quando o accounts-daemon expõe parental
# controls (ver 20-stack.sh, seção 9) — nunca pode ser levado na cascata.
if rpm -q malcontent >/dev/null 2>&1; then
  log "protegendo o malcontent (pode ser exigido pelo flatpak)"
  dnf -y mark user malcontent >/dev/null 2>&1 \
    || log "aviso: falha ao marcar o malcontent como user-installed"
  PROT_PKGS+=",malcontent"
fi

# preflight_remocao — simula a transação com as mesmas proteções da remoção
# real e aborta se algum pacote mantido aparecer no plano. Protege contra uma
# cascata inesperada (ex.: um app novo que passe a exigir o plasma-workspace).
# LC_ALL=C deixa o cabeçalho da transação estável ("Removing:") seja qual for
# o idioma do sistema.
preflight_remocao() {
  local sim='' p conflitos=()
  sim="$(LC_ALL=C dnf -C remove --assumeno --setopt=protected_packages="${PROT_PKGS}" "${PKGS[@]}" 2>&1 || true)"
  # cache vazio/indisponível: tenta com os repositórios (mesmo fallback da
  # remoção real); se ainda assim não houver plano, segue sem bloquear.
  if ! grep -q '^Removing' <<<"${sim}"; then
    sim="$(LC_ALL=C dnf remove --assumeno --setopt=protected_packages="${PROT_PKGS}" "${PKGS[@]}" 2>&1 || true)"
  fi
  if ! grep -q '^Removing' <<<"${sim}"; then
    if grep -qi 'protected' <<<"${sim}"; then
      log "preflight: a transação removeria um pacote protegido — NÃO removendo"
      return 1
    fi
    log "preflight: sem plano de transação (cache/rede?) — NÃO removendo"
    return 1
  fi
  for p in "${KEEP_PKGS[@]}" "${APP_PKGS[@]}"; do
    rpm -q "$p" >/dev/null 2>&1 || continue
    grep -Eq "(^|[[:space:]])${p}[[:space:]]" <<<"${sim}" && conflitos+=("$p")
  done
  if ((${#conflitos[@]})); then
    log "preflight: a remoção levaria junto: ${conflitos[*]}"
    return 1
  fi
  return 0
}

if ((${#PKGS[@]} > 0)) && ! preflight_remocao; then
  log "remoção NÃO executada — o serviço tentará de novo no próximo boot"
  restore_prot
  trap - EXIT
  exit 1
fi

rc=0
if ((${#PKGS[@]} > 0)); then
  log "removendo: ${PKGS[*]}"
  # tenta primeiro só com cache (boot pode estar sem rede); depois com rede
  if ! dnf -C -y remove --setopt=protected_packages="${PROT_PKGS}" "${PKGS[@]}"; then
    log "cache indisponível — tentando com acesso a repositórios..."
    dnf -y remove --setopt=protected_packages="${PROT_PKGS}" "${PKGS[@]}" || rc=1
  fi
else
  log "nada a remover (já limpo)"
fi

restore_prot
trap - EXIT

if (( rc == 0 )); then
  log "concluído — desabilitando o serviço"
  systemctl disable omyfedora-remove-plasma.service >/dev/null 2>&1 || true
  rm -f /usr/local/libexec/omyfedora-remove-plasma /etc/systemd/system/omyfedora-remove-plasma.service || true
  systemctl daemon-reload >/dev/null 2>&1 || true
else
  log "FALHOU — nova tentativa no próximo boot (veja: journalctl -u omyfedora-remove-plasma)"
fi
exit "${rc}"
