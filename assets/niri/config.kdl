// msbos — configuração do niri (defaults completos + integração Noctalia)
// Referência: /usr/share/doc/niri/wiki e docs.noctalia.dev/noctalia/compositor-settings/niri

// Zed: o editor de notebooks (.ipynb) ainda é experimental e só é habilitado
// quando o processo do Zed nasce com esta variável. O niri a repassa aos apps
// que spawna (Super+E, launcher, terminal). O REPL em arquivos .py não depende dela.
environment {
    LOCAL_NOTEBOOK_DEV "1"
}

input {
    keyboard {
        repeat-delay 300
        repeat-rate 33
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 2
    // Noctalia (Option 2): wallpaper estacionário no backdrop
    background-color "transparent"
    // Anel de foco fino na cor da paleta macOS (mSecondary #5E5CE6).
    // Sem isto o niri usa o padrão (width 4, azul #7fc8ff).
    focus-ring {
        width 1
        active-color "#5E5CE6"
        inactive-color "#2C2C2E"
    }
}

// Wallpaper do Noctalia no backdrop do overview (Option 2 da doc oficial)
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Cantos arredondados (metade do padrão inicial: 20 → 10).
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Transparência global: 90% de opacidade em todas as janelas. O msbos não roda
// o KWin, então a regra "Transparência Global" do KDE (opacityactive/inactive
// = 94) vira esta window-rule sem match — genérica primeiro, específicas
// depois (a ordem importa: regra posterior sobrepõe). A opacidade é
// multiplicada pela própria da janela (ex.: alacritty com 0.85 no
// alacritty.toml fica ~0.77 na tela). O blur global usa `background-effect`
// (niri 26.04+), que desfoca o wallpaper atrás das janelas semitransparentes.
// draw-border-with-background false: por padrão o niri desenha o anel de foco
// (que só existe na janela ATIVA) como retângulo sólido ATRÁS da janela — com
// transparência, o retângulo tapava o wallpaper e o efeito "sumia" ao focar.
// Com false, o anel vira um contorno AO REDOR da janela e a transparência fica
// igual com ou sem foco (como no KWin, que é 94 para ativa e inativa).
window-rule {
    opacity 0.90
    draw-border-with-background false

    // Desfoca o wallpaper atrás de qualquer janela semitransparente.
    background-effect {
        blur true
    }
}

// Navegadores: opacidade total (100%) — página e devtools em fundo claro ficam
// ilegíveis com o alpha global. Regra posterior sobrescreve a genérica acima;
// app-ids são os que o niri reporta no Wayland, sempre ancorados (sem ^…$ o
// `chrome` pegaria `google-chrome`). O Firefox aparece como `firefox` (RPM) ou
// `org.mozilla.firefox` (flatpak/desktop file). Para incluir outro navegador
// (Edge, Vivaldi…), acrescente o app-id à regex.
window-rule {
    match app-id=r#"^(brave-browser|google-chrome|chromium|firefox|org\.mozilla\.firefox)$"#
    opacity 1.0
}

// Terminal translúcido no formato vidro (combina com opacity = 0.85 em
// assets/alacritty/alacritty.toml; o draw-border-with-background da regra
// global cuida do anel de foco). ATENÇÃO: `background-effect` só existe a
// partir do niri 26.04 — em versão mais antiga o config inteiro falha ao
// carregar (nó inesperado), então remova este bloco se um dia o pacote de
// `niri` voltar a ser mais velho.
window-rule {
    match app-id="Alacritty"

    background-effect {
        blur true
    }
}

// Diálogo do polkit (KDE): modal pequeno e centralizado, nunca tela cheia.
window-rule {
    match app-id="polkit-kde-authentication-agent-1"
    match app-id="polkit-kde"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 240; }
}

// Janela de settings do Noctalia flutuante e dimensionada
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Permite ações de notificação e ativação de janela vindas do Noctalia
debug {
    honor-xdg-activation-with-invalid-serial

    // VM (QEMU/KVM + virtio-gpu-gl/virgl): contorna bugs de driver do QEMU — o
    // cursor aparece de cabeça para baixo (qemu#2315) e/ou surgem artefatos na
    // tela. Descomente as 3 linhas ao rodar o msbos dentro de uma VM:
    // disable-cursor-plane
    // disable-direct-scanout
    // wait-for-frame-completion-before-queueing
}

// Shell Noctalia: barra, launcher, notificações, OSD, lock e wallpaper
// (o wallpaper é gerenciado pelo Noctalia; para usar swaybg no lugar,
//  descomente a linha abaixo e remova a layer-rule do noctalia-wallpaper)
spawn-at-startup "noctalia"
// Agente de autenticação polkit (KDE): sem ele o udisks2 nega montar volumes
// externos no Dolphin ("Not authorized to perform operation").
// polkit-kde segue o tema Breeze do KDE (o msbos não usa mais Kvantum).
spawn-at-startup "/usr/libexec/kf6/polkit-kde-authentication-agent-1"
// spawn-at-startup "msbos-wallpaper"

binds {
    // ── Noctalia ────────────────────────────────────────────────────────────
    Mod+Space       { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S           { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab         { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+P hotkey-overlay-title="Displays (Noctalia)" { spawn-sh "noctalia msg panel-toggle raycursive/niri-displays:panel"; }

    // ── msbos: apps ──────────────────────────────────────────────────────────
    Mod+B { spawn "brave-browser"; }
    Mod+E { spawn "zed"; }

    // ── Defaults do niri (completos) ────────────────────────────────────────

    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+Shift+T hotkey-overlay-title="New Terminal window: alacritty" { spawn "alacritty"; }
    Mod+D hotkey-overlay-title="Launcher (Noctalia)" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Alt+L hotkey-overlay-title="Lock (Noctalia)" { spawn-sh "noctalia msg session lock"; }

    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }


    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }



    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }


    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }


    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }



    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+M { maximize-window-to-edges; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }


    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }
}
