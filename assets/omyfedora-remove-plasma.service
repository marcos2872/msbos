[Unit]
Description=omyfedora — remove o shell do Plasma (uma vez, antes da sessão gráfica)
Documentation=https://github.com/marcos2872/omyfedora
Before=graphical.target
After=local-fs.target network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/omyfedora-remove-plasma
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
