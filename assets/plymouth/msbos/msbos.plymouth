# msbos — tema de boot (Plymouth)
#
# Reaproveita a animação do tema spinner (pacote plymouth-theme-spinner) e
# troca o watermark do Fedora pelo wordmark do msbos. O fundo usa a cor
# mSurface da paleta do sistema (#0B0B0D).
#
# Aplicação (feita pelo 50-configs.sh): copiar os PNGs do spinner para este
# diretório, instalar este arquivo + watermark.png e rodar
#   plymouth-set-default-theme -R msbos
# (o -R regenera o initramfs; sem ele o tema não entra no boot).
[Plymouth Theme]
Name=msbos
Description=msbos — splash de boot (spinner + wordmark)
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/msbos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.96
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0B0B0D
BackgroundEndColor=0x0B0B0D
ProgressBarBackgroundColor=0x606060
ProgressBarForegroundColor=0xffffff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
