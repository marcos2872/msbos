<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Ações polkit do helper privilegiado do msbos (/usr/local/libexec/msbos-priv).

  Cada subcomando é uma ação própria, casada pelo argv[1] (anotação
  org.freedesktop.policykit.exec.argv1). Todas as ações que MUDAM o sistema exigem
  senha de administrador SEMPRE (auth_admin, sem "keep"): a janela de senha é o
  portão final de cada alteração pedida por um agente de IA.

  Só a simulação de remoção usa auth_admin_keep (não altera nada) para evitar
  prompts repetidos enquanto o agente mostra o plano.

  Verificação depois de instalar (rode o comando pkaction com a opção de ação
  org.msbos.priv.dnf-install e a opção verbose).
-->
<policyconfig>
  <vendor>msbos</vendor>
  <vendor_url>https://github.com/marcos2872/msbos</vendor_url>

  <action id="org.msbos.priv.dnf-install">
    <description>Instalar pacotes (msbos)</description>
    <message>Autenticação necessária para instalar pacotes a pedido de um assistente</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">dnf-install</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.msbos.priv.dnf-simulate-remove">
    <description>Simular a remoção de pacotes (msbos)</description>
    <message>Autenticação necessária para simular a remoção de pacotes (nada será removido)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">dnf-simulate-remove</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.msbos.priv.dnf-remove">
    <description>Remover pacotes (msbos)</description>
    <message>Autenticação necessária para REMOVER pacotes a pedido de um assistente</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">dnf-remove</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.msbos.priv.svc-enable">
    <description>Habilitar e iniciar um serviço (msbos)</description>
    <message>Autenticação necessária para habilitar e iniciar um serviço a pedido de um assistente</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">svc-enable</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.msbos.priv.svc-disable">
    <description>Desabilitar e parar um serviço (msbos)</description>
    <message>Autenticação necessária para desabilitar e parar um serviço a pedido de um assistente</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">svc-disable</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.msbos.priv.svc-restart">
    <description>Reiniciar um serviço (msbos)</description>
    <message>Autenticação necessária para reiniciar um serviço a pedido de um assistente</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/msbos-priv</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">svc-restart</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
