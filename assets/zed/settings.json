// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// omyfedora: instalado com install_file_once — ajustes feitos no Zed depois
// da instalação nunca são sobrescritos por uma reexecução do install.sh.
{
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "jupyter": {
    "kernel_selections": {
      "python": "zed-python",
    },
  },
  "feature_flags": {
    "notebooks": "on",
  },
  // Extensões do usuário: o Zed instala/atualiza sozinho no primeiro start.
  // A lista corresponde ao que está instalado hoje (temas de ícones e linguagens).
  "auto_install_extensions": {
    "colored-zed-icons-theme": true,
    "csv": true,
    "dockerfile": true,
    "emmet": true,
    "git-firefly": true,
    "html": true,
    "java": true,
    "jetbrains-new-ui-icons": true,
    "kdl": true,
    "kotlin": true,
    "log": true,
    "make": true,
    "powershell": true,
    "sql": true,
    "toml": true,
    "xml": true,
  },
}
