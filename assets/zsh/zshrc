# msbos — ~/.zshrc minimalista
# Autocomplete: sugestões inline do histórico (aceite com → ou End),
# syntax highlighting e fzf (Ctrl+R para histórico fuzzy, Ctrl+T arquivos).

# ─── PATH do usuário ────────────────────────────────────────────────────────
# ~/.local/bin: instaladores de apps (Zed, uv, pipx...) colocam binários aqui.
typeset -U path
path=("$HOME/.local/bin" $path)
export PATH

# ─── Histórico ──────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_VERIFY

# ─── Completions (Tab com menu navegável e case-insensitive) ────────────────
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ─── Navegação ──────────────────────────────────────────────────────────────
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS

# ─── Sugestões inline do histórico ──────────────────────────────────────────
# Cor da paleta macOS do Noctalia (mPrimary #8E8E93) — mesma do shell.
if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#8E8E93'
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# ─── Destaque de sintaxe (válido/inválido) — carregar por último ────────────
if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# ─── fzf: Ctrl+R (histórico), Ctrl+T (arquivos) ─────────────────────────────
if [[ -f /usr/share/fzf/shell/key-bindings.zsh ]]; then
  source /usr/share/fzf/shell/key-bindings.zsh
fi

# ─── Ferramentas de dev (Rust / nvm) ────────────────────────────────────────
[[ -f ~/.cargo/env ]] && source ~/.cargo/env
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# ─── Prompt minimalista (caminho + branch git + ❯) ──────────────────────────
# Cores da paleta macOS do Noctalia: mSecondary #5E5CE6 (caminho), verde
# terminal #32D74B (branch), mPrimary #8E8E93 (❯).
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '%F{#32D74B}(%b)%f '
setopt PROMPT_SUBST
PROMPT='%F{#5E5CE6}%~%f ${vcs_info_msg_0_}%F{#8E8E93}❯%f '
